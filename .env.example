# ==========================
# Database
# ==========================

DB_URL=jdbc:postgresql://localhost:5432/devhub
DB_USERNAME=postgres
DB_PASSWORD=your_password

# ==========================
# Test Database
# ==========================

TEST_DB_URL=jdbc:postgresql://localhost:5432/devhub_test
