# ==========================
# Spring
# ==========================

SPRING_PROFILE=local

# ==========================
# JWT
# ==========================

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

JWT_ACCESS_EXPIRATION=your_access_expiration
JWT_REFRESH_EXPIRATION=your_refresh_expiration